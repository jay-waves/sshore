# Embedded remote entry point. Rendered values are shell-quoted by Go.
# Keep stdin free for setup frames, binary fallback and the eventual session.
version={{q .Version}}
server={{q .Server}}
command={{q .Command}}
mode={{q .Mode}}
name={{q .Session}}

if command -v "$server" >/dev/null 2>&1; then
    server=$(command -v "$server")
{{if eq .Server "sshore"}}else
    server="$HOME/.local/bin/sshore"
{{end}}fi
case "$server" in /*) ;; *) server="$PWD/$server" ;; esac
remote_version=
if [ -e "$server" ]; then
    remote_version=$("$server" --version) || remote_version=
fi

{{if eq .Command "daemon-admin"}}
exec "$server" daemon-admin
{{else if .List}}
if [ "$remote_version" != "sshore $version" ]; then
    printf '%s\n' 'sshore: inventory requires matching remote release; no software changed' >&2
    exit 1
fi
exec "$server" inventory "$version"{{if .ListJSON}} --diagnostics{{end}}
{{else if or (eq .Command "kill") (eq .Command "kill-resource") (eq .Command "rename")}}
# Management never installs or updates software.
if [ "$remote_version" != "sshore $version" ]; then
    printf '%s\n' "sshore: $command requires the installed remote version to match $version; no software changed" >&2
    exit 1
fi
{{if eq .Command "kill-resource"}}
exec "$server" kill-resource "$version" "$name" {{q .TaskIdentity}}
{{else}}
exec "$server" {{q .Action}} "$name"{{if eq .Command "rename"}} {{q .NewName}}{{end}} "$version"{{if .Instance}} {{q .Instance}}{{end}}
{{end}}
{{else}}
# Reject a downgrade before downloading anything. Unknown versions are left to
# the Go coordinator, which refuses destructive updates without known state.
if printf '%s\n' "$remote_version" | awk -v local="$version" 'END {
    release = "(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)"
    if (NR != 1 || $0 !~ ("^sshore " release "$") || local !~ ("^" release "$")) exit 1
    split(local, l, "."); split($2, r, ".")
    for (i = 1; i <= 3; i++) {
        if (length(r[i]) > length(l[i])) exit 0
        if (length(r[i]) < length(l[i])) exit 1
        if (("x" r[i]) > ("x" l[i])) exit 0
        if (("x" r[i]) < ("x" l[i])) exit 1
    }
    exit 1
}'; then
    printf '%s\n' "sshore: remote executable is newer than local $version; update the local client. No downgrade performed." >&2
    exit 1
fi
if [ "$remote_version" = "sshore $version" ]; then
    exec "$server" bootstrap "$server" "$mode" "$name"
fi
if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
    {{fatal "automatic setup supports Linux amd64 only"}}
fi
printf '%s\n' "[sshore] Downloading sshore $version and verifying checksum..." >&2
umask 077
setup_dir=$(mktemp -d "${TMPDIR:-/tmp}/sshore-setup.XXXXXXXX") || {
    {{fatal "remote setup: cannot create staging directory; no shells stopped"}}
}
trap 'rm -rf -- "$setup_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
if ! {
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 15 --max-time 60 --retry 2 {{q .InstallerURL}} -o "$setup_dir/install.sh" &&
    sh "$setup_dir/install.sh" --version "$version" --bin-dir "$setup_dir/bin" --prepare-only
} >"$setup_dir/install.log" 2>&1; then
    cat "$setup_dir/install.log" >&2
    {{download}}
    IFS=' ' read -r setup_size setup_hash setup_extra || {
        {{fatal "remote setup: client download unavailable; no shells stopped"}}
    }
    case "$setup_size" in ''|*[!0-9]*|?????????*)
        {{fatal "remote setup: invalid transfer size"}}
    ;; esac
    if [ "$setup_size" -le 0 ] || [ "$setup_size" -gt 67108864 ] || [ -n "$setup_extra" ] || [ "${#setup_hash}" -ne 64 ]; then
        {{fatal "remote setup: client download failed or transfer invalid; no shells stopped"}}
    fi
    case "$setup_hash" in *[!0-9a-f]*)
        {{fatal "remote setup: invalid transfer checksum"}}
    ;; esac
    mkdir -p "$setup_dir/bin" && head -c "$setup_size" > "$setup_dir/bin/sshore" || {
        {{fatal "remote setup: transfer failed; no shells stopped"}}
    }
    setup_actual=$(sha256sum < "$setup_dir/bin/sshore") || {
        {{fatal "remote setup: checksum tool failed; no shells stopped"}}
    }
    if [ "$(wc -c < "$setup_dir/bin/sshore")" -ne "$setup_size" ] || [ "${setup_actual%% *}" != "$setup_hash" ]; then
        {{fatal "remote setup: transferred executable checksum mismatch; no shells stopped"}}
    fi
    chmod 700 "$setup_dir/bin/sshore" || {
        {{fatal "remote setup: cannot prepare executable; no shells stopped"}}
    }
fi
[ "$("$setup_dir/bin/sshore" --version)" = "sshore $version" ] || {
    {{fatal "remote setup: prepared binary version mismatch. No shells stopped."}}
}
# Do not exec: the staging directory must remain until the coordinator returns.
"$setup_dir/bin/sshore" bootstrap "$server" "$mode" "$name"
{{end}}
