+// RemoveDirectory removes an empty directory by sending SSH_FXP_RMDIR.
+func (cl *Client) RemoveDirectory(name string) error {
+	return wrapPathError("rmdir", name, cl.sendPacket(context.Background(), nil, &sshfx.RmdirPacket{Path: name}))
+}
