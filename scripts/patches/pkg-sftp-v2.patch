+
+// chtimes binds Linux FSETSTAT to the open descriptor across rename and unlink.
+func (f *File) chtimes(atime, mtime time.Time) error {
+	if runtime.GOOS != "linux" {
+		return os.Chtimes(f.filename, atime, mtime)
+	}
+	conn, err := f.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var opErr error
+	err = conn.Control(func(fd uintptr) {
+		opErr = os.Chtimes("/proc/self/fd/"+strconv.FormatUint(uint64(fd), 10), atime, mtime)
+	})
+	return cmp.Or(err, opErr)
+}
