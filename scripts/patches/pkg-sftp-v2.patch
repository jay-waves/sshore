+// RemoveFile removes a file by sending SSH_FXP_REMOVE.
+func (cl *Client) RemoveFile(name string) error {
+	return wrapPathError("remove", name, cl.sendPacket(context.Background(), nil, &sshfx.RemovePacket{Path: name}))
+}
+
+// RemoveDirectory removes an empty directory by sending SSH_FXP_RMDIR.
+func (cl *Client) RemoveDirectory(name string) error {
+	return wrapPathError("rmdir", name, cl.sendPacket(context.Background(), nil, &sshfx.RmdirPacket{Path: name}))
+}
+
 // Remove removes the named file or (empty) directory.
