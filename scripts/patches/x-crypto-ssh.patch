+func (s *sessionStdin) WriteBuffers(parts [][]byte) (int, error) {
+	if writer, ok := s.Writer.(interface{ WriteBuffers([][]byte) (int, error) }); ok {
+		return writer.WriteBuffers(parts)
+	}
+	var written int
+	for _, part := range parts {
+		n, err := s.Write(part)
+		written += n
+		if err != nil {
+			return written, err
+		}
+		if n != len(part) {
+			return written, io.ErrShortWrite
+		}
+	}
+	return written, nil
+}
+
 func (s *sessionStdin) Close() error {
 	return s.ch.CloseWrite()
 }
