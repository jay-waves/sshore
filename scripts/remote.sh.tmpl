# Keep stdin free for the selected service's protocol.
{{if .Helper}}
unset SSHORE_CONFIRM_ADDR SSHORE_CONFIRM_TOKEN
{{if not .KeepSocket}}unset SSHORE_SOCKET{{end}}
{{end}}
server={{q .Server}}
[ -n "$server" ] || server=sshore
if command -v "$server" >/dev/null 2>&1; then
    server=$(command -v "$server")
elif [ "$server" = sshore ]; then
    server="$HOME/.local/bin/sshore"
fi
case "$server" in /*) ;; *) server="$PWD/$server" ;; esac
{{if .Mismatch}}
remote_version=
if [ -e "$server" ]; then
    remote_version=$("$server" --version{{if .Helper}} 2>/dev/null{{end}}) || remote_version=
fi
if [ "$remote_version" != {{q (printf "sshore %s" .Version)}} ]; then
    {{.Mismatch}}
fi
{{end}}
{{if .Ready}}
printf '%s\n' {{q .Ready}}
"$server" {{.Request}} || exec cat >/dev/null
{{else}}
exec "$server" {{.Request}}
{{end}}
