[!linux] skip
env PATH=$WORK/tools:$PATH
chmod 755 tools/gh
env GITHUB_SHA=abc GH_STATUS=0 GITHUB_REF=refs/tags/v0.4.1
exec bash $REPO/scripts/release.sh
grep '^release create v0.4.1 --verify-tag ' calls
cmp packages/linux.sha256 packages/SHA256SUMS

rm calls
env GITHUB_REF=refs/tags/v0.4
! exec bash $REPO/scripts/release.sh
! exists calls
env GITHUB_REF=refs/tags/v0.0.0
! exec bash $REPO/scripts/release.sh
! exists calls

env GITHUB_REF=refs/tags/v0.4.1 GH_STATUS=1
! exec bash $REPO/scripts/release.sh
exists calls

-- tools/gh --
#!/bin/sh
printf '%s\n' "$*" > calls
exit "$GH_STATUS"
-- packages/linux.tar.gz --
fixture
-- packages/windows.zip --
fixture
-- packages/linux.sha256 --
fixture
