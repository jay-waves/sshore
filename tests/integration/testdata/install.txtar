[!linux] skip
env HOME=$WORK PATH=$WORK/tools:$PATH INSTALL=$REPO/install.sh
env 'BIN=directory with spaces'
chmod 755 tools/curl
chmod 755 tools/uname
mkdir $BIN
cp old $BIN/sshore
chmod 755 $BIN/sshore

# Bad arguments must fail before download or installation.
! exec sh $INSTALL --version ../main
! exec sh $INSTALL --version
! exec sh $INSTALL --unknown
env TEST_ARCH=aarch64
! exec sh $INSTALL
env TEST_ARCH=x86_64 TEST_OS=Darwin
! exec sh $INSTALL
env TEST_OS=Linux
! exists downloads

exec sh bundle 0.3.1
cp SHA256SUMS good-sums
exec sh -c 'cat good-sums good-sums > SHA256SUMS'
! exec sh $INSTALL --bin-dir $BIN
cmp $BIN/sshore old
cp good-sums SHA256SUMS
env TEST_DOWNLOAD_FAIL=1
! exec sh $INSTALL --bin-dir $BIN --version 0.3.1
cmp $BIN/sshore old
! exists $BIN/sshore-backup
env TEST_DOWNLOAD_FAIL=
rm downloads

stdin $INSTALL
exec sh -s -- --bin-dir $BIN
stdout 'Installed sshore 0.3.1'
exec $BIN/sshore --version
stdout '^sshore 0.3.1$'
exec sh -c '. "$HOME/.profile"; command -v sshore'
stdout 'directory with spaces/sshore$'
grep 'sshore_install_dir=' .bashrc
grep 'sshore_install_dir=' .zshenv
cmp $BIN/sshore-backup old
grep '/latest/download/SHA256SUMS' downloads
grep '/download/v0.3.1/sshore_0.3.1_linux_amd64.tar.gz' downloads

exec sh -c 'printf tampered >> sshore_0.3.1_linux_amd64.tar.gz'
! exec sh $INSTALL --bin-dir $BIN
stderr 'SHA256 mismatch'
cmp $BIN/sshore sshore
cmp $BIN/sshore-backup old

# A release with the renamed command uses install for the apply step.
exec sh bundle 0.3.2
exec sh $INSTALL --bin-dir $BIN --version 0.3.2
exec $BIN/sshore --version
stdout '^sshore 0.3.2$'

-- bundle --
set -eu
asset=sshore_${1}_linux_amd64.tar.gz
printf '#!/bin/sh\nversion=%s\n' "$1" > sshore
cat payload >> sshore
chmod 755 sshore
tar -czf "$asset" sshore
sha256sum "$asset" > SHA256SUMS
-- payload --
set -eu
if [ "$1" = --version ]; then echo "sshore $version"; exit; fi
action=bootstrap
if [ "$version" = 0.3.2 ]; then action=install; fi
if [ "$1" = --help ]; then printf '  %s  Install sshore\n' "$action"; exit; fi
[ "$1" = "$action" ] && [ "$2" = --apply ] || exit 2
target=${3#here:}
cp -p "$target" "$target-backup"
cp "$0" "$target.next"
mv "$target.next" "$target"
-- tools/uname --
#!/bin/sh
case "$1" in -s) echo "${TEST_OS:-Linux}";; -m) echo "${TEST_ARCH:-x86_64}";; esac
-- tools/curl --
#!/bin/sh
set -eu
while [ "$#" -gt 0 ]; do
    case "$1" in
        --proto|--proto-redir) test "$2" = '=https'; secure=${secure:-}x; shift ;;
        -o) out=$2; shift ;;
        https://*) url=$1 ;;
    esac
    shift
done
test "${secure:-}" = xx
printf '%s\n' "$url" >> "$HOME/downloads"
test -z "${TEST_DOWNLOAD_FAIL:-}"
cp "$HOME/${url##*/}" "$out"
-- old --
#!/bin/sh
echo 'sshore 0.3.0'
